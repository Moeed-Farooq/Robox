# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# AppsFlyer strict mode (kids / COPPA SDK variant)
$RNAppsFlyerStrictMode = true

# Required for @react-native-firebase (Firebase Swift pods)
$RNFirebaseAsStaticFramework = true
# Required when using use_frameworks! with react-native-google-mobile-ads
$RNGoogleMobileAdsAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'Robox' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26+ workaround: fmt 11.0.2 consteval errors with Apple Clang 21
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end

      # Perkox SDK still globs ios/**/*.h, so both xcframework slices copy
      # PerkoxOfferwall.h into the same Headers folder during archive.
      next unless target.name == 'PerkoxReactNativeSdk'
      next unless target.respond_to?(:headers_build_phase) && target.headers_build_phase

      target.headers_build_phase.files.to_a.each do |build_file|
        name = build_file.file_ref&.display_name.to_s
        next unless name == 'PerkoxOfferwall.h'

        target.headers_build_phase.remove_build_file(build_file)
      end
    end
  end
end
